# Base URL of the SpendWise REST API (Week 3 back-end).
# Default "/api/v1" is proxied by the Vite dev server to http://localhost:4000
# (see vite.config.js). Point it at a full URL when the API is hosted elsewhere:
# VITE_API_URL=https://spendwise-api.example.com/api/v1
VITE_API_URL=/api/v1

# Where the dev-server proxy forwards /api requests (only used by vite.config.js)
# API_PROXY_TARGET=http://localhost:4000
