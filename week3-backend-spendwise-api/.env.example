# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Database ----
# Local MongoDB:      mongodb://127.0.0.1:27017/spendwise
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spendwise
# Leave EMPTY (default) to auto-start an in-memory MongoDB with demo data – zero setup.
# Data is lost on restart; set a real URI for persistence.
MONGODB_URI=

# ---- Auth ----
# Use a long random string in production: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Comma-separated list of allowed front-end origins
CORS_ORIGIN=http://localhost:5173
