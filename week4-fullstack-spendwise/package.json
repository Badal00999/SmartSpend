{
  "name": "spendwise-fullstack",
  "version": "1.0.0",
  "private": true,
  "description": "SpendWise – integrated full-stack expense tracker (React client + Express/MongoDB API). Week 4 deliverable of the YUVA internship.",
  "type": "module",
  "author": "Badal (Badal00999)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "fullstack",
    "react",
    "express",
    "mongodb",
    "rest-api",
    "sse",
    "expense-tracker",
    "yuva-internship"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Badal00999/SmartSpend"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "test": "npm --prefix server test && npm --prefix client test -- --run",
    "test:api": "npm --prefix server test",
    "test:client": "npm --prefix client test -- --run",
    "test:e2e": "npm --prefix e2e test",
    "seed": "npm --prefix server run seed",
    "lint": "npm --prefix client run lint"
  }
}
