# ─────────────────────────────────────────────────────────────────────────────
# SpendWise full-stack – environment template
# Server settings: copy to server/.env (or set shell variables).
# Client VITE_* settings belong in client/.env, not root .env.
# Every value below is optional: the defaults give a fully working local stack.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Server (server/src/config/env.js) ----
NODE_ENV=development
PORT=4000

# Leave EMPTY to use the throw-away in-memory MongoDB that comes pre-seeded with
# demo data (demo@spendwise.app / Demo1234) – nothing to install.
# Set it to a real database for persistent data, e.g.:
#   mongodb://127.0.0.1:27017/spendwise
#   mongodb+srv://user:pass@cluster0.abcd.mongodb.net/spendwise
MONGODB_URI=

# 32+ characters in production (the server refuses weak secrets there)
JWT_SECRET=change-me-in-production-please-32-characters
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Serve the built React app from the API process (one port, no proxy).
# Defaults to true when NODE_ENV=production. Run `npm run build` first.
# SERVE_CLIENT=true
# CLIENT_DIST=../client/dist

# ---- Client (client/.env / client/src/services/api.js) ----
# Base path of the API. "/api/v1" is proxied by Vite to http://localhost:4000.
# VITE_API_URL=/api/v1
# API_PROXY_TARGET=http://localhost:4000
